@model List<Booking>
@{ ViewData["Title"] = "My Bookings"; var isStaff = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Coordinator); }

<div class="section">
    <div class="container">
        <div class="section-header" style="margin-bottom:24px;">
            <div class="section-label">My Account</div>
            <h2>@(isStaff ? "All Bookings" : "My Bookings")</h2>
            <p>Track your event venue reservation requests and statuses.</p>
        </div>

        <div class="card" style="padding:0; overflow:hidden;">
            <div style="overflow-x:auto;">
                <table style="width:100%; border-collapse:collapse; text-align:left;">
                    <thead>
                        <tr style="background:#f8fafc; border-bottom:1px solid var(--border); font-size:13px; color:var(--muted);">
                            <th style="padding:16px;">Venue</th>
                            @if (isStaff) { <th style="padding:16px;">Client</th> }
                            <th style="padding:16px;">Event Date</th>
                            <th style="padding:16px;">Time</th>
                            <th style="padding:16px;">Guests</th>
                            <th style="padding:16px;">Status</th>
                            <th style="padding:16px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" style="text-align:center; padding:30px; color:var(--muted);">No bookings yet.</td></tr>
                        }
                        else
                        {
                            foreach (var b in Model)
                            {
                                <tr style="border-bottom:1px solid var(--border); font-size:14px;">
                                    <td style="padding:16px; font-weight:600;">@(!string.IsNullOrEmpty(b.VenueName) ? b.VenueName : ("Venue #" + b.VenueId))</td>
                                    @if (isStaff) { <td style="padding:16px;">@b.UserName</td> }
                                    <td style="padding:16px;">@b.EventDate.ToString("yyyy-MM-dd")</td>
                                    <td style="padding:16px;">@b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")</td>
                                    <td style="padding:16px;">@b.GuestCount guests</td>
                                    <td style="padding:16px;"><span class="badge @b.Status">@b.Status</span></td>
                                    <td style="padding:16px;">
                                        @if (b.Status == BookingStatus.Pending || b.Status == BookingStatus.Confirmed)
                                        {
                                            <form asp-action="Cancel" asp-route-id="@b.Id" method="post" class="inline" onsubmit="return confirm('Cancel this booking?');">
                                                <button class="link danger">Cancel</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
