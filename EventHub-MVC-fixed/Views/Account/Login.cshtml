@model LoginVm
@{ ViewData["Title"] = "Login"; }

<div class="section">
    <div class="container" style="max-width:480px; margin:0 auto;">
        <div class="card">
            <div class="section-header center" style="margin-bottom:16px;">
                <div class="section-label">Welcome Back</div>
                <h2>Login to EventHub</h2>
            </div>

            <div id="loginAlert" class="alert alert-error" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")">
                @if (!ViewData.ModelState.IsValid)
                {
                    <text>Please fix the errors below.</text>
                }
            </div>

            <form asp-action="Login" method="post" class="form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@(ViewData["ReturnUrl"] ?? "")" />
                <div asp-validation-summary="ModelOnly" class="err-text"></div>

                <div class="form-group">
                    <label asp-for="Email">Email Address</label>
                    <input asp-for="Email" class="form-control" placeholder="e.g. john@client.com" />
                    <span asp-validation-for="Email" class="err-text"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="err-text"></span>
                </div>

                <div style="margin-top:16px; display:flex; gap:8px; align-items:center;">
                    <button type="submit" class="btn btn-primary">Login</button>
                    <a asp-action="Register" class="btn btn-outline">Register</a>
                </div>
            </form>
        </div>
    </div>
</div>

