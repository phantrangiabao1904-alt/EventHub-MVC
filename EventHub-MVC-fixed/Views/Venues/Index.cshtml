@model List<Venue>
@{ ViewData["Title"] = "Venues"; }

<section class="section">
    <div class="container">
        <div class="section-header center">
            <div class="section-label">Explore Spaces</div>
            <h2>Available Venues</h2>
            <p>Find the perfect location tailored for your upcoming event.</p>
        </div>

        <form method="get" class="filter-bar" style="margin-top:24px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
            <input type="text" name="search" value="@ViewData["Search"]" placeholder="Search venues..." class="form-control" style="max-width:250px;" />
            <select name="capacity" class="form-control" style="max-width:220px;">
                <option value="">Any capacity</option>
                @foreach (var c in new[] { 50, 150, 300, 500 })
                {
                    <option value="@c" selected="@((ViewData["Capacity"] as int?) == c)">At least @c guests</option>
                }
            </select>
            <button class="btn btn-primary">Filter</button>
        </form>

        <div class="grid grid-3" style="margin-top:24px;">
            @if (!Model.Any())
            {
                <div style="grid-column:1/-1; text-align:center; color:var(--muted); padding:40px;">No venues found.</div>
            }
            else
            {
                foreach (var v in Model)
                {
                    <div class="card venue-card" style="display:flex; flex-direction:column; overflow:hidden; padding:0;">
                        <div style="height:200px; background:#1e293b;">
                            @if (!string.IsNullOrEmpty(v.ImageUrl))
                            {
                                <img src="@v.ImageUrl" alt="@v.Name" style="width:100%; height:200px; object-fit:cover;" />
                            }
                        </div>
                        <div style="padding:20px; display:flex; flex-direction:column; flex-grow:1;">
                            <span style="font-size:12px; text-transform:uppercase; color:var(--accent); font-weight:600; margin-bottom:6px;">Capacity: @v.Capacity guests</span>
                            <h3 style="font-size:18px; margin-bottom:8px;">@v.Name</h3>
                            <p style="color:var(--muted); font-size:14px; margin-bottom:16px; flex-grow:1;">@(string.IsNullOrEmpty(v.Description) ? "No description available." : v.Description)</p>
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:auto; border-top:1px solid var(--border); padding-top:12px;">
                                <span style="font-weight:bold; font-size:16px; color:var(--primary);">@v.Price.ToString("N0") VND</span>
                                <a class="btn btn-primary btn-sm" asp-action="Details" asp-route-id="@v.Id">View</a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>
