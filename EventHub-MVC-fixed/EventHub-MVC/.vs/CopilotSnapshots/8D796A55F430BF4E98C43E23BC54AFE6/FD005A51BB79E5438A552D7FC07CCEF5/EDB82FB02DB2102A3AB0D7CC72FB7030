@model List<EventHub.Models.Booking>
@{ ViewData["Title"] = "Admin Dashboard" }

<h2>All System Bookings</h2>
<p>Review and update reservation statuses across all venues.</p>

<div class="card" style="padding: 0; overflow: hidden;">
	<div style="overflow-x: auto;">
		<table style="width:100%; border-collapse: collapse; text-align:left;">
			<thead>
				<tr style="background:#f8fafc; border-bottom:1px solid var(--border); font-size:13px; color:var(--muted);">
					<th style="padding:16px;">ID</th>
					<th style="padding:16px;">Client</th>
					<th style="padding:16px;">Venue</th>
					<th style="padding:16px;">Date</th>
					<th style="padding:16px;">Status</th>
					<th style="padding:16px; text-align:right;">Actions</th>
				</tr>
			</thead>
			<tbody>
				@if (!Model.Any())
				{
					<tr><td colspan="6" style="text-align:center; padding:30px; color:var(--muted);">No bookings found in the database.</td></tr>
				}
				else
				{
					foreach (var b in Model)
					{
						<tr style="border-bottom:1px solid var(--border); font-size:14px;">
							<td style="padding:16px;">#@b.Id</td>
							<td style="padding:16px;">@(!string.IsNullOrEmpty(b.UserName) ? b.UserName : ("User #" + b.UserId))</td>
							<td style="padding:16px; font-weight:600;">@(!string.IsNullOrEmpty(b.VenueName) ? b.VenueName : ("Venue #" + b.VenueId))</td>
							<td style="padding:16px;">@b.EventDate.ToString("yyyy-MM-dd")</td>
							<td style="padding:16px;"><span class="badge @b.Status">@b.Status</span></td>
							<td style="padding:16px; text-align:right;">
								<form asp-controller="Bookings" asp-action="SetStatus" asp-route-id="@b.Id" method="post" class="inline" style="display:inline-block; margin-right:4px;">
									@Html.AntiForgeryToken()
									<input type="hidden" name="status" value="CONFIRMED" />
									<button class="btn btn-sm" style="background:#16a34a; color:white; border:none; padding:4px 8px;">Confirm</button>
								</form>
								<form asp-controller="Bookings" asp-action="SetStatus" asp-route-id="@b.Id" method="post" class="inline" style="display:inline-block;">
									@Html.AntiForgeryToken()
									<input type="hidden" name="status" value="CANCELLED" />
									<button class="btn btn-sm" style="background:#dc2626; color:white; border:none; padding:4px 8px;">Cancel</button>
								</form>
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
</div>
